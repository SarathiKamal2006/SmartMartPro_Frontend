# SmartMart Backend Environment Variables
# ─────────────────────────────────────────
# Gmail SMTP Configuration for sending OTP emails.
#
# STEP 1: Enable 2-Step Verification on your Google Account
#         https://myaccount.google.com/security
#
# STEP 2: Generate an App Password
#         https://myaccount.google.com/apppasswords
#         Select "Mail" and your device, then copy the 16-char password.
#
# STEP 3: Fill in the values below and rename this file to .env

GMAIL_USER=smartmartpro2k26@gmail.com
GMAIL_APP_PASSWORD=wsvx wmqd hfwp stey

# MongoDB Atlas connection string
# Get it from: Atlas Dashboard → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartmart?retryWrites=true&w=majority

# JWT secret for token signing
JWT_SECRET=smartmart_super_secret_key_change_in_production

PORT=5000

# Razorpay Payment Gateway (Get from: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
